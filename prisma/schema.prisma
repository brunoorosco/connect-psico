generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                       String                 @id @default(cuid())
  name                     String
  email                    String                 @unique
  emailVerified            DateTime?
  image                    String?
  phone                    String?
  role                     UserRole               @default(DEFAULT)
  password                 String?
  isTwoFactorAuthEnabled   Boolean                @default(false)
  twoFactorAuthVerified    DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  active                   Boolean                @default(true)
  index                    Int                    @default(autoincrement())
  isNewProfile             Boolean                @default(true)
  Account                  Account[]
  Session                  Session[]
  VideoCallParticipant     VideoCallParticipant[]
  patientAppointments      Appointment[]          @relation("PatientAppointments")
  professionalAppointments Appointment[]          @relation("ProfessionalAppointments")
  availabilities           Availability[]
  CertificateConfig        CertificateConfig[]
  ComentariosProfessional  Comentarios[]          @relation("ReviewsProfessional")
  ComentariosUser          Comentarios[]          @relation("ReviewsUser")
  receivedMessages         Message[]              @relation("ReceivedMessages")
  sentMessages             Message[]              @relation("SentMessages")
  Message                  Message[]
  NotePatient              NotePatient[]          @relation("NotePatientProfessional")
  patientUser              Pacientes[]            @relation("PatientUser")
  Professional             Professional?
  PatientProfessional      PatientProfessional[]  @relation("PatientProfessional")
  PatientProfessional1     PatientProfessional[]  @relation("PatientProfessional1")
  BankAccount              BankAccount[]
  appointmentHistories     AppointmentHistory[]

  @@index([id, email])
  @@map("users")
}

model Professional {
  id                 Int       @id @default(autoincrement())
  abordagem          String?
  userId             String    @unique
  bio                String?
  ufConselho         String?   @map("uf_conselho") @db.VarChar(2)
  especialidade      String[]
  numConselho        String?   @map("num_conselho") @db.VarChar(8)
  education          String?
  tipoAtendimento    String?   @default("ambos") @map("tipo_atendimento")
  valorAtendimento   Int?      @default(0) @map("valor_atendimento")
  tituloAcademico    String?   @map("titulo_academico")
  createdAt          DateTime  @default(now())
  tempoConsulta      Int?      @default(60) @map("tempo_consulta")
  updatedAt          DateTime  @updatedAt
  publicoAlvo        String[]  @map("publico_alvo")
  isProfileCompleted Boolean   @default(false) @map("is_profile_completed")
  experiencia        Int       @default(0) @map("experiencia")
  visivel            Boolean   @default(true) @map("visivel")
  deletedAt          DateTime? @map("deleted_at")
  username           String?   @unique @map("username") @db.VarChar(40)
  cidade             String?   @db.VarChar(25)
  complemento        String?   @db.VarChar(25)
  estado             String?   @db.VarChar(2)
  logradouro         String?   @db.VarChar(25)
  numero             String?   @db.VarChar(10)
  bairro             String?   @db.VarChar(25)
  cep                String?   @db.VarChar(8)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, username, userId])
  @@map("professionals")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Pacientes {
  id                 Int           @id @default(autoincrement())
  professionalId     String?       @map("professional_id")
  patientId          String        @map("patient_id")
  address            String?
  birthDate          String?       @map("birth_date")
  emergencyContact   String?       @map("emergency_contact")
  medicalRecordId    String        @unique @map("prontuario_id")
  cep                String?
  city               String?
  neighborhood       String?
  notes              String?
  number             String?
  state              String?
  street             String?
  deletedAt          DateTime?     @map("deleted_at")
  consentRecording   Boolean       @default(false) @map("consent_record")
  consentVersion     String?
  consentRecordingAt DateTime?     @map("consent_at")
  notePatient        NotePatient[]
  patient            User          @relation("PatientUser", fields: [patientId], references: [id])

  @@index([patientId])
  @@map("patients")
}

model PatientProfessional {
  id             Int    @id @default(autoincrement())
  patientId      String @map("patitent_id")
  professionalId String @map("professional_id")

  professional User @relation("PatientProfessional", fields: [professionalId], references: [id])
  patient      User @relation("PatientProfessional1", fields: [patientId], references: [id])

  createdAt DateTime @default(now())

  @@index([patientId, professionalId])
  @@map("patient_professional")
}

model NotePatient {
  id             Int       @id @default(autoincrement())
  patientId      Int       @map("patitent_id")
  notes          String
  createdAt      DateTime  @default(now())
  prescription   String
  professionalId String    @map("professional_id")
  patients       Pacientes @relation(fields: [patientId], references: [id])
  professional   User      @relation("NotePatientProfessional", fields: [professionalId], references: [id])

  @@map("note_patients")
}

model Comentarios {
  id             Int         @id @default(autoincrement())
  userId         String
  professionalId String
  appointmentId  Int         @map("appointment_id")
  comment        String
  createdAt      DateTime    @default(now()) @map("created_at")
  rating         Int
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professional   User        @relation("ReviewsProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  user           User        @relation("ReviewsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([id])
  @@map("comentarios")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Appointment {
  professionalId       String               @map("professional_id")
  patientId            String               @map("patient_id")
  appointmentDate      DateTime             @map("appointment_date")
  status               Status               @default(PENDING)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @map("updated_at")
  id                   Int                  @id @default(autoincrement())
  roomId               String?              @default(cuid()) @map("room_id")
  tipoAtendimento      String?              @default("ambos") @map("tipo_atendimento")
  review               Boolean              @default(false)
  priceCents           Int                  @default(0)
  expiresAt            DateTime?
  patient              User                 @relation("PatientAppointments", fields: [patientId], references: [id])
  professional         User                 @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  Comentarios          Comentarios[]
  payment              Payment?
  Payout               Payout?
  Refund               Refund?
  appointmentHistories AppointmentHistory[]

  @@index([professionalId, patientId, status])
  @@map("appointments")
}

model Availability {
  professionalId String   @map("professional_id")
  dayOfWeek      Int      @map("day_of_week")
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")
  isAvailable    Boolean  @default(true) @map("is_available")
  id             Int      @id @default(autoincrement())
  psychologist   User     @relation(fields: [professionalId], references: [id])

  @@index([id, professionalId])
  @@map("availabilities")
}

model Message {
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  userId     String?
  id         Int      @id @default(autoincrement())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  User       User?    @relation(fields: [userId], references: [id])

  @@map("messages")
}

model VideoCallRoom {
  id           String                 @id @default(cuid())
  scheduledAt  DateTime
  createdAt    DateTime               @default(now())
  participants VideoCallParticipant[]

  @@map("video_call_rooms")
}

model VideoCallParticipant {
  id       Int           @id @default(autoincrement())
  userId   String
  roomId   String
  joinedAt DateTime      @default(now())
  room     VideoCallRoom @relation(fields: [roomId], references: [id])
  user     User          @relation(fields: [userId], references: [id])

  @@unique([userId, roomId])
}

model NotifyDigest {
  receiverId   String   @id
  firstEventAt DateTime @default(now())
  lastEventAt  DateTime @default(now())
  windowEndAt  DateTime
  msgCount     Int      @default(0)
}

model CertificateConfig {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  name       String
  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@map("certificate_config")
}

model BankAccount {
  id                Int         @id @default(autoincrement())
  accountType       AccountType
  bankName          String
  branchNumber      String      @db.VarChar(10)
  accountNumber     String      @db.VarChar(20)
  pixKey            String?     @db.VarChar(20)
  prepaymentEnabled Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Exemplo: relacionamento opcional com usuário ou empresa
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("bank_account")
}

enum AccountType {
  CHECKING // Conta Corrente
  SAVINGS // Conta Poupança
}

//pagamentos
model Payment {
  id                String        @id @default(cuid())
  appointmentId     Int           @unique
  status            PaymentStatus @default(PENDING)
  provider          String
  providerPaymentId String?       @unique
  checkoutUrl       String?
  qrCodeText        String?
  expiresAt         DateTime?
  amountCents       Int
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointment       Appointment   @relation(fields: [appointmentId], references: [id])

  @@map("payment")
}

//reembolso
model Refund {
  id               String       @id @default(cuid())
  appointmentId    Int          @unique
  reason           RefundReason
  amountCents      Int
  providerRefundId String?
  status           String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  appointment      Appointment  @relation(fields: [appointmentId], references: [id])

  @@map("refund")
}

//repasses
model Payout {
  id               String      @id @default(cuid())
  appointmentId    Int         @unique
  professionalId   String
  amountCents      Int
  status           String
  providerPayoutId String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  appointment      Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payout")
}

model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())

  @@map("idempotencyKey")
}

model AppointmentHistory {
  id            Int       @id @default(autoincrement())
  appointmentId Int
  action        String // RESCHEDULED, CANCELLED, CONFIRMED, etc
  previousDate  DateTime?
  newDate       DateTime?
  reason        String? // Motivo do cancelamento ou reagendamento
  performedBy   String // ID do usuário que realizou a ação
  performedAt   DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [performedBy], references: [id])

  @@index([appointmentId])
  @@index([performedBy])
  @@map("appointment_histories")
}

enum UserRole {
  DEFAULT
  ADMIN
  SUPERVISOR
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
  CONCLUDED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
  FAILED
}

enum RefundReason {
  PATIENT_CANCEL_48H
  PATIENT_CANCEL_LT48H
  PRO_CANCEL
  OTHER
}
