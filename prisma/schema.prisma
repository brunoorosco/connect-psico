generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                       String                 @id @default(cuid())
  index                    Int                    @default(autoincrement())
  name                     String
  email                    String                 @unique
  emailVerified            DateTime?
  image                    String?
  active                   Boolean                @default(true)
  phone                    String?
  role                     UserRole               @default(DEFAULT)
  password                 String?
  isTwoFactorAuthEnabled   Boolean                @default(false)
  twoFactorAuthVerified    DateTime?
  isNewProfile             Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  patientAppointments      Appointment[]          @relation("PatientAppointments")
  professionalAppointments Appointment[]          @relation("ProfessionalAppointments")
  availabilities           Availability[]
  receivedMessages         Message[]              @relation("ReceivedMessages")
  sentMessages             Message[]              @relation("SentMessages")
  Message                  Message[]
  Professional             Professional?
  patientUser              Pacientes[]            @relation("PatientUser")
  patientProfessional      Pacientes[]            @relation("PatientProfessional")
  Session                  Session[]
  Account                  Account[]
  NotePatient              NotePatient[]          @relation("NotePatientProfessional")
  VideoCallParticipant     VideoCallParticipant[]
  CertificateConfig        CertificateConfig[]
  ComentariosProfessional  Comentarios[]          @relation("ReviewsProfessional")
  ComentariosUser          Comentarios[]          @relation("ReviewsUser")

  @@index([id])
  @@map("users")
}

model Professional {
  id                 Int       @id @default(autoincrement())
  numConselho        String?   @map("num_conselho") @db.VarChar(8)
  ufConselho         String?   @map("uf_conselho") @db.VarChar(2)
  publicoAlvo        String[]  @map("publico_alvo")
  username           String?   @map("username") @db.VarChar(40)
  especialidade      String[]
  abordagem          String?
  tituloAcademico    String?   @map("(titulo_academico)")
  education          String?
  tipoAtendimento    String?   @default("ambos") @map("tipo_atendimento")
  bio                String?
  valorAtendimento   Int?      @default(0) @map("valor_atendimento")
  tempoConsulta      Int?      @default(60) @map("tempo_consulta")
  visivel            Boolean   @default(true) @map("visivel")
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime? @map("deleted_at")
  isProfileCompleted Boolean   @default(false) @map("is_profile_completed")
  experiencia        Int       @default(0) @map("experiencia")

  @@index([id, username])
  @@map("professionals")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Pacientes {
  id               Int           @id @default(autoincrement())
  birthDate        String?       @map("birth_date")
  emergencyContact String?       @map("emergency_contact")
  address          String?
  medicalRecordId  String        @unique @map("prontuario_id")
  professionalId   String        @map("professional_id")
  patientId        String        @map("patient_id")
  deletedAt        DateTime?     @map("deleted_at")
  cep              String?
  street           String?
  neighborhood     String?
  city             String?
  state            String?
  number           String?
  notes            String?
  patient          User          @relation("PatientUser", fields: [patientId], references: [id])
  professional     User          @relation("PatientProfessional", fields: [professionalId], references: [id])
  notePatient      NotePatient[]

  @@map("patients")
}

model NotePatient {
  id             Int       @id @default(autoincrement())
  patientId      Int       @map("patitent_id")
  notes          String
  prescription   String
  professionalId String    @map("professional_id")
  patients       Pacientes @relation(fields: [patientId], references: [id])
  createdAt      DateTime  @default(now())
  professional   User      @relation("NotePatientProfessional", fields: [professionalId], references: [id])

  @@map("note_patients")
}

model Comentarios {
  id             Int         @id @default(autoincrement())
  comment        String
  rating         Int
  userId         String
  appointmentId  Int         @map("appointment_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  professionalId String
  professional   User        @relation("ReviewsProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user           User        @relation("ReviewsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([id])
  @@map("comentarios")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Appointment {
  id              Int           @id @default(autoincrement())
  professionalId  String        @map("professional_id")
  patientId       String        @map("patient_id")
  appointmentDate DateTime      @map("appointment_date")
  status          Status        @default(PENDING)
  tipoAtendimento String?       @default("ambos") @map("tipo_atendimento")
  roomId          String?       @default(cuid()) @map("room_id")
  review          Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  patient         User          @relation("PatientAppointments", fields: [patientId], references: [id])
  professional    User          @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  Comentarios     Comentarios[]

  @@map("appointments")
}

model Availability {
  id             Int      @id @default(autoincrement())
  professionalId String   @map("professional_id")
  dayOfWeek      Int      @map("day_of_week")
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")
  isAvailable    Boolean  @default(true) @map("is_available")
  psychologist   User     @relation(fields: [professionalId], references: [id])

  @@map("availabilities")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  userId     String?
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  User       User?    @relation(fields: [userId], references: [id])

  @@map("messages")
}

model VideoCallRoom {
  id           String                 @id @default(cuid())
  participants VideoCallParticipant[]
  scheduledAt  DateTime
  createdAt    DateTime               @default(now())

  @@map("video_call_rooms")
}

model VideoCallParticipant {
  id       Int           @id @default(autoincrement())
  userId   String
  roomId   String
  joinedAt DateTime      @default(now())
  user     User          @relation(fields: [userId], references: [id])
  room     VideoCallRoom @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
}

model NotifyDigest {
  receiverId   String   @id
  firstEventAt DateTime @default(now())
  lastEventAt  DateTime @default(now())
  windowEndAt  DateTime
  msgCount     Int      @default(0)
}

model CertificateConfig {
  id     Int    @id @default(autoincrement())
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")
  name   String

  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name])
  @@map("certificate_config")
}

enum UserRole {
  DEFAULT
  ADMIN
  SUPERVISOR
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
  CONCLUDED
}
